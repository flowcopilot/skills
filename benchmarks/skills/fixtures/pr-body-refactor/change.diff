diff --git a/src/transport/client.ts b/src/transport/client.ts
new file mode 100644
--- /dev/null
+++ b/src/transport/client.ts
@@ -0,0 +1,5 @@
+export async function send(path: string, body: unknown) {
+  const response = await fetch(`${BASE_URL}${path}`, { method: "POST", body: JSON.stringify(body) });
+  if (!response.ok) throw new Error(`send failed: ${response.status}`);
+  return response.json();
+}
diff --git a/src/transport/stream.ts b/src/transport/stream.ts
new file mode 100644
--- /dev/null
+++ b/src/transport/stream.ts
@@ -0,0 +1,9 @@
+export async function* stream(path: string) {
+  const response = await fetch(`${BASE_URL}${path}`);
+  const reader = response.body!.getReader();
+  while (true) {
+    const { done, value } = await reader.read();
+    if (done) return;
+    yield new TextDecoder().decode(value);
+  }
+}
